# SEO and Verification Configuration

# Site URL (used in sitemap, metadata, and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://tinkerhub-sngce.com

# Google Search Console verification ID
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_verification_id_here

# Optional: AI Agent crawling credentials (if needed)
# This helps with crawling by ChatGPT, Claude, and other AI systems
AI_AGENT_CRAWL_ALLOWED=true
